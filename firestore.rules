rules_version = '2';

// Firestore 보안 규칙
// 배포 방법: Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 "게시"
service cloud.firestore {
  match /databases/{database}/documents {

    // 랭킹 컬렉션: /leaderboards/{leaderKey}/entries/{entryId}
    // leaderKey 규약:
    //   - 정기고사(regular): "{setId}"(레거시 ML) 또는 "{subject}_{setId}"
    //       · ML 중간 1~5, ML 기말 106·201~204, DS 1~8 등 (setId는 정수 1~9999)
    //   - 주차별(weekly): "{subject}_weekly_w{week}"  (예: ml_weekly_w13)
    //   - subject ∈ {ml, ds, dl, sec}
    match /leaderboards/{leaderKey}/entries/{entryId} {

      // 누구나 읽기 가능 (TOP 랭킹 표시)
      allow read: if true;

      // ── 정기고사(중간/기말) 기록 ─────────────────────────────
      // 필드: nickname, score, totalQuestions, durationSec, setId, recordedAt
      function isRegular() {
        return
          leaderKey.matches('^([0-9]{1,4}|(ml|ds|dl|sec)_[0-9]{1,4})$') &&
          request.resource.data.keys().hasOnly([
            'nickname', 'score', 'totalQuestions',
            'durationSec', 'setId', 'recordedAt'
          ]) &&
          request.resource.data.nickname is string &&
          request.resource.data.nickname.size() >= 1 &&
          request.resource.data.nickname.size() <= 16 &&
          request.resource.data.score is int &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 100 &&
          request.resource.data.totalQuestions is int &&
          request.resource.data.totalQuestions >= 1 &&
          request.resource.data.totalQuestions <= 100 &&
          request.resource.data.durationSec is int &&
          request.resource.data.durationSec >= 30 &&
          request.resource.data.durationSec <= 10800 &&
          request.resource.data.setId is int &&
          request.resource.data.setId >= 1 &&
          request.resource.data.setId <= 9999 &&
          request.resource.data.recordedAt is timestamp;
      }

      // ── 주차별 확인문제 기록 ─────────────────────────────────
      // 필드: nickname, score, totalQuestions, durationSec, week, kind, recordedAt
      function isWeekly() {
        return
          leaderKey.matches('^(ml|ds|dl|sec)_weekly_w[0-9]{1,2}$') &&
          request.resource.data.keys().hasOnly([
            'nickname', 'score', 'totalQuestions',
            'durationSec', 'week', 'kind', 'recordedAt'
          ]) &&
          request.resource.data.nickname is string &&
          request.resource.data.nickname.size() >= 1 &&
          request.resource.data.nickname.size() <= 16 &&
          request.resource.data.score is int &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 100 &&
          request.resource.data.totalQuestions is int &&
          request.resource.data.totalQuestions >= 1 &&
          request.resource.data.totalQuestions <= 50 &&
          request.resource.data.durationSec is int &&
          request.resource.data.durationSec >= 10 &&
          request.resource.data.durationSec <= 10800 &&
          request.resource.data.week is int &&
          request.resource.data.week >= 1 &&
          request.resource.data.week <= 30 &&
          request.resource.data.kind == 'weekly' &&
          request.resource.data.recordedAt is timestamp;
      }

      // 쓰기는 정기고사 또는 주차별 스키마 중 하나를 만족해야 함
      allow create: if isRegular() || isWeekly();

      // 등록된 기록은 수정/삭제 불가 (랭킹 조작 방지)
      allow update, delete: if false;
    }

    // 문항별 익명 정답률 통계: /questionStats/{qid}
    // 스키마: { attempts: int, correct: int, updatedAt: timestamp }
    match /questionStats/{qid} {
      // 누구나 읽기 가능 (통계 표시용)
      allow read: if true;

      // 최초 생성: attempts == 1, correct ∈ {0,1}
      allow create: if
        request.resource.data.keys().hasOnly(['attempts','correct','updatedAt']) &&
        request.resource.data.attempts is int &&
        request.resource.data.correct is int &&
        request.resource.data.attempts == 1 &&
        request.resource.data.correct >= 0 &&
        request.resource.data.correct <= 1 &&
        request.resource.data.updatedAt is timestamp;

      // 증분 업데이트: attempts·correct 모두 정확히 기존값+0 또는 +1, 감소 금지
      allow update: if
        request.resource.data.keys().hasOnly(['attempts','correct','updatedAt']) &&
        request.resource.data.attempts is int &&
        request.resource.data.correct is int &&
        request.resource.data.attempts == resource.data.attempts + 1 &&
        (request.resource.data.correct == resource.data.correct ||
         request.resource.data.correct == resource.data.correct + 1) &&
        request.resource.data.correct <= request.resource.data.attempts &&
        request.resource.data.updatedAt is timestamp;

      // 삭제 불가
      allow delete: if false;
    }
  }
}
